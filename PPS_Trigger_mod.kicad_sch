		(exclude_from_sim no)
		(at 317.754 276.86 0)
		(effects
			(font
				(size 1.905 1.905)
				(thickness 0.381)
				(bold yes)
			)
		)
		(uuid "29361ff3-8ac1-4d09-8baf-4d9a20737763")
	)
	(text "AP33772S PROGRAMMABLE POWER SUPPLY AND TERMINALS"
		(exclude_from_sim no)
		(at 256.032 120.65 0)
		(effects
			(font
				(size 3.81 3.81)
				(thickness 0.762)
				(bold yes)
			)
		)
		(uuid "47915c4f-3457-4dcd-8cfe-45b8fdc64d27")
	)
	(text "USB-C INPUT FOR POWER AND DATA\n"
		(exclude_from_sim no)
		(at 74.168 119.888 0)
		(effects
			(font
				(size 3.81 3.81)
				(thickness 0.762)
				(bold yes)
			)
		)
		(uuid "681b2e86-5106-4f2d-b8fa-dbfc1f82b713")
	)
	(text "DESIGN NOTES\n\n- PPS trigger board, not a regulated bench supply - output tracks \n  the charger's PPS contract, no local CV/CC control loop\n- Programming: ICSP only for bootloader; CH340C/UART for \n  day-to-day flashing after that\n- No crystal-free option - Y1 required for reliable UART baud rate\n- I2C bus shared: AP33772S + OLED, single 4.7k pull-up pair\n- Output: dual 2-pin screw terminals, both wired to the same \n  VOUT/GND net, for multi-load use"
		(exclude_from_sim no)
		(at 302.006 233.426 0)
		(effects
			(font
				(size 1.905 1.905)
				(thickness 0.381)
				(bold yes)
			)
			(justify left)
		)
		(uuid "7b0f0ef5-0963-461d-93e9-5aa7eb9696cf")
	)
	(text "ATMEGA328P-A AND RELATED CIRCUITRY"
		(exclude_from_sim no)
		(at 119.634 277.876 0)
		(effects
			(font
				(size 3.81 3.81)
				(thickness 0.762)
				(bold yes)
			)
		)
		(uuid "8b96a50d-d086-4b62-a8d6-ab945adcd2c0")
	)
	(text "NANO PPS - ATMEGA328P-A CONTROLLED \nAP33772S PPS TO DELIVER POWER UPTO\n45 WATTS.  \n"
		(exclude_from_sim no)
		(at 354.584 261.112 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.508)
				(bold yes)
			)
		)
		(uuid "8dd29591-34bf-4b4d-b265-e5d93151fdd8")
	)
	(text "No fast short-circuit protection - relies on \nAP33772S's OCP loop (~30ms debounce). \nSingle N-MOS, no reverse-current blocking. \nSee design discussion for trade-offs."
		(exclude_from_sim no)
		(at 143.764 73.914 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "92bd1300-e4ea-4275-bccd-bf3e491cc171")
	)
	(text "Firmware-enforced minimum output: 5V \n(headroom for buck regulator dropout - do not allow lower in firmware)"
		(exclude_from_sim no)
		(at 300.482 107.442 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a97fb4d8-804b-45c9-9aeb-af393793838b")
	)
	(text "Current sense resistor - ISENP/IFB traces \nmust route directly from resistor pads (Kelvin sensing),\nnot tapped from a via"
		(exclude_from_sim no)
		(at 172.72 24.892 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "c641433d-fdcb-44b3-943b-a2f5bb4bbc00")
	)
